{
  "name": "fleetnorm-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start:ingest": "node src/ingest/index.js",
    "start:processor": "node src/processor/index.js",
    "start:api": "node src/api/index.js",
    "sim": "node src/simulator/index.js",
    "seed": "node scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "coverage": "c8 --check-coverage --lines 80 --reporter=text --reporter=lcov --include \"src/shared/**\" --include \"src/processor/normalise.js\" --include \"src/processor/rules.js\" --include \"src/ingest/parse.js\" --include \"src/api/util.js\" --exclude \"src/shared/db.js\" --exclude \"src/shared/logger.js\" --exclude \"src/shared/metrics.js\" --exclude \"src/shared/config.js\" --exclude \"src/shared/mappings.js\" node --test tests/*.test.js"
  },
  "dependencies": {
    "@clickhouse/client": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "mongodb": "^6.9.0",
    "opossum": "^8.1.4",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.2.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": { "c8": "^10.1.2" }
}
